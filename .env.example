# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# ── Frontend (exposed to the browser — Vite only inlines VITE_*-prefixed vars) ──
# Project Settings > API in the Supabase dashboard. The publishable/anon key
# is safe to expose client-side — it's the whole point of Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only (used by /api/* and server/scripts/ — never exposed to the browser) ──
# Same project URL as above.
SUPABASE_URL=
# Project Settings > API > service_role secret. Bypasses RLS entirely —
# never commit it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (server-side only — never exposed to the browser).
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sending address in your Resend account.
# Until you verify a custom domain, Resend's shared onboarding@resend.dev works for testing.
FROM_EMAIL=onboarding@resend.dev

# Shown in email headers/footers and in the frontend UI.
STORE_NAME=GENZ-WEARS

# Support address shown in the footer of every email.
SUPPORT_EMAIL=support@genzwears.example

# Used to build absolute links inside emails (Shop Now, View Cart, etc), and
# as the redirect target for Supabase Auth's password-reset emails.
# Point this at wherever the frontend is actually served.
SITE_URL=http://localhost:5173

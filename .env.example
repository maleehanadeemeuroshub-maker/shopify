# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# Resend API key (server-side only — never exposed to the browser).
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sending address in your Resend account.
# Until you verify a custom domain, Resend's shared onboarding@resend.dev works for testing.
FROM_EMAIL=onboarding@resend.dev

# Shown in email headers/footers and in the frontend UI.
STORE_NAME=GENZ-WEARS

# Support address shown in the footer of every email.
SUPPORT_EMAIL=support@genzwears.example

# Used to build absolute links inside emails (Shop Now, View Cart, etc).
# Point this at wherever the frontend is actually served.
SITE_URL=http://localhost:5173

# Port the Express email API listens on.
PORT=8787
